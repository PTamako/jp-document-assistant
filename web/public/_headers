# Security headers for native asset-first routes. API and OCR engine
# module-worker responses retain their own headers in worker/index.js.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' blob: data:; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com https://apis.google.com; worker-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://gmail.googleapis.com https://www.googleapis.com https://accounts.google.com https://oauth2.googleapis.com https://apis.google.com https://cdn.jsdelivr.net https://paddle-model-ecology.bj.bcebos.com https://huggingface.co https://cas-bridge.xethub.hf.co https://cdn-lfs.hf.co; font-src 'self'; object-src 'none'; frame-src 'self' blob: https://accounts.google.com https://docs.google.com https://drive.google.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
