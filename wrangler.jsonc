{
  // Approved 2026-11-12 for ONE live production Worker and ONE dedicated D1/R2.
  // Future Wrangler deployments use native Static Assets; first API upload temporarily embedded static assets.
  // Never run a deploy from GitHub Actions or add Preview Workers/DB/R2.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jp-document-assistant",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-11",
  // Dynamic API requests must reach worker/index.js, including POST /api/auth/login;
  // OCR module-worker assets also need the Worker to attach their isolated CSP.
  // Everything else remains asset-first to minimize Cloudflare Worker requests.
  "assets": {"directory":"./dist", "binding":"ASSETS", "not_found_handling":"single-page-application", "run_worker_first":["/api/*","/assets/worker-entry-*.js"]},
  "d1_databases": [{"binding":"DB", "database_name":"jp-document-assistant", "database_id":"22a671c0-3f6c-4707-adf1-b24ac95330c6", "migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"DOCUMENTS", "bucket_name":"jp-document-assistant-private"}],
  // Calls to the two existing Workers use same-account Service Bindings (zero extra Workers).
  // Each receiving endpoint stays fail-closed without an approved account mapping.
  "services": [
    {"binding":"HOMEFLOW_BRIDGE_SERVICE","service":"homeflow"},
    {"binding":"ZHIXUE_BRIDGE_SERVICE","service":"it-study-platform"}
  ],
  "ai": {"binding":"AI"},
  "vars": {
    "R2_BUCKET_NAME":"jp-document-assistant-private",
    "ENABLE_EXPERIMENTAL_OCR":"false",
    "ENABLE_DOCUMENT_AI":"true",
    "AI_ANALYSIS_DAILY_LIMIT":"2",
    "OCR_CALLS_PER_USER_DAY":"1",
    "OCR_APP_UTC_DAILY_LIMIT":"1"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled":false}
}
